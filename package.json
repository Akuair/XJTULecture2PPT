{
  "name": "xjtu-lecture2ppt",
  "version": "0.1.0",
  "private": true,
  "description": "Convert authorized XJTU lecture recordings to PDF handouts and OCR text on Windows.",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^6.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  },
  "scripts": {
    "build": "corepack pnpm -r --if-present build",
    "package:win": "corepack pnpm --filter @xjtu-lecture2ppt/desktop package:win",
    "dev": "corepack pnpm --filter @xjtu-lecture2ppt/desktop dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "corepack pnpm -r --if-present typecheck"
  }
}
